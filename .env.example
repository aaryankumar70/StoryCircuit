# ==============================================================================
# ReelForge (StoryCircuit) — Zero-Cost YouTube Shorts Automation Configuration
# Copy to `.env` and customize as needed. Never commit `.env`.
# ==============================================================================

# 1. Local / Free-Tier LLM Brain (Zero Cost)
# Uses local Ollama (`qwen2.5:3b-instruct` by default) with optional Gemini Free Tier.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
OLLAMA_TIMEOUT_SEC=120
# Optional: Google AI Studio free-tier key for higher-quality scripts & prompts
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# 2. Per-Beat Visual Sources (Zero Cost)
# Primary image source: auto | pollinations | archival | cards_only
VISUAL_MODE=auto
POLLINATIONS_MODEL=flux
POLLINATIONS_TIMEOUT_SEC=45

# 3. TTS & Captions (Zero Cost)
# Edge-TTS is free & fast with exact word-boundary timestamps (no extra RAM).
# Set TTS_VOICE_PRIMARY / TTS_VOICE_SECONDARY for dialogue scripts.
TTS_ENGINE=edge
TTS_VOICE_PRIMARY=en-US-AndrewNeural
TTS_VOICE_SECONDARY=en-US-AvaNeural
TTS_RATE=+4%

# 4. Daily 2-Video Schedule
SCHEDULER_TIMEZONE=Asia/Kolkata
SLOT1_TIME=12:30
SLOT2_TIME=20:30
MAX_DAILY_VIDEOS=2

# 5. YouTube Data API v3 (Direct Upload & Auto-Scheduling)
# Mode: live | simulation
YOUTUBE_PUBLISHING_MODE=live
# Privacy: private | unlisted | public (scheduled publishAt uses private until scheduled time)
YOUTUBE_PRIVACY_STATUS=private
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CATEGORY_ID=27

# 6. Web Dashboard (8090 avoids ClipSnip:8000 and GiggleBeats:8080)
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8090

# 7. Format & Quality Control Bounds (<=120s Shorts 9:16; >120s Auto Landscape 16:9)
SHORT_MAX_DURATION_SEC=120.0
MIN_DURATION_SEC=18.0
MAX_DURATION_SEC=120.0
LONG_MAX_DURATION_SEC=3600.0
TARGET_LUFS=-16.0
MAX_TRUE_PEAK_DB=-1.0
AUTO_SCHEDULER_ENABLED=1
AUTO_GARBAGE_CLEANUP=1
