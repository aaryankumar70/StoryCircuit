# ==============================================================================
# CurioLoop (Curiosity Engine) Local Environment Configuration
# Copy this file to `.env` and fill in your local credentials. NEVER commit `.env`.
# ==============================================================================

# 1. Google Cloud Project Reference (Hosts YouTube Data API v3 & Desktop OAuth Client)
GCP_PROJECT_ID=your-gcp-project-id

# 2. Topic & Script Generation (Optional: Gemini Free Tier; falls back to curated topics if empty)
GEMINI_API_KEY=your_gemini_api_key_here

# 3. YouTube Data API v3 (Desktop OAuth 2.0 Client + Offline Refresh Token)
# Run `python scripts/auth_youtube.py` to generate YOUTUBE_REFRESH_TOKEN interactively.
YOUTUBE_CLIENT_ID=your_youtube_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret
YOUTUBE_REFRESH_TOKEN=your_youtube_oauth_refresh_token

# 4. Publishing Safety Modes (Defaults prevent unintended public or cross-platform uploads)
# YOUTUBE_PUBLISHING_MODE: simulation | live
YOUTUBE_PUBLISHING_MODE=simulation
# YOUTUBE_PRIVACY_STATUS: private | unlisted | public (keep `private`; publishAt publishes at schedule time)
YOUTUBE_PRIVACY_STATUS=private
# INSTAGRAM_PUBLISHING_MODE: disabled | simulation | live (keep `disabled` unless explicitly configured)
INSTAGRAM_PUBLISHING_MODE=disabled

# 5. Autonomous Local Scheduler (Asia/Kolkata / IST)
SCHEDULER_TIMEZONE=Asia/Kolkata
SCHEDULER_PUBLISH_SLOT1_TIME=12:30
SCHEDULER_PUBLISH_SLOT2_TIME=20:30
DASHBOARD_PORT=8000

# 6. Optional Instagram Graph API (Only needed if enabling Instagram Reels)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_API_VERSION=v22.0

# 6b. Telegram Operational Notifications (Optional - Free Bot API)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_DAILY_SUMMARY_HOUR_IST=21

# 6c. Local Storage Cleanup (IST Calendar Days)
VIDEO_RETENTION_DAYS=1

# 7. Local Runtime Paths & Rendering
# Point CHROME to your local Chrome or Microsoft Edge executable.
CHROME=C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe
FACELESS_HOME=./models
SOFTWARE_GL=1
